# Flask Secret Key
SECRET_KEY=change-this-to-a-secure-secret-key

# Database Connection (Leave empty for SQLite in local dev, or provide PostgreSQL URL on Render)
DATABASE_URL=

# Environment Mode (development / production / testing)
FLASK_ENV=development

# Optional AI API Key for enhanced Chatbot integration
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Base URL for email notification links
APP_BASE_URL=http://localhost:5000

# SMTP Email Notification Configuration (e.g. Gmail, Mailtrap, SendGrid, Amazon SES)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=CampusConnect <noreply@campusconnect.edu>
MAIL_ENABLED=true
MAIL_DEBUG_LOG=true
